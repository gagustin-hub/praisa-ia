    {
      "parameters": {
        "message": "={{\n(() => {\n  const p = $('CAF - Consultar producto').item.json.prod || {};\n  const registros = Array.isArray($json.v_existencia)\n    ? $json.v_existencia\n    : [];\n\n  const limpio = (v) => (v ?? '').toString().trim();\n\n  const codigo = limpio(p.codpro);\n  const producto = limpio(p.nombre_prod);\n  const categoria = limpio(p.categoria);\n  const fabricante = limpio(p.codigo_fabricante);\n  const unidad = limpio(p.umedida);\n\n  const precioNumerico = Number(p.precioa || 0);\n  const precio = precioNumerico > 0\n    ? \"Q\" + precioNumerico.toLocaleString(\"en-US\", {\n        minimumFractionDigits: 2,\n        maximumFractionDigits: 2\n      })\n    : \"No registrado\";\n\n  let total = 0;\n\n  const detalleBodegas = registros.map(r => {\n    const bodega = limpio(r.bodega);\n    const existencia = Number(r.existencia || 0);\n\n    total += existencia;\n\n    return \"• Bodega \" + bodega + \": \" +\n      existencia.toLocaleString(\"en-US\", {\n        minimumFractionDigits: 0,\n        maximumFractionDigits: 2\n      }) +\n      \" unidades\";\n  }).join(\"\\n\");\n\n  let respuesta =\n    \"Información consultada directamente en CAF Web:\\n\\n\" +\n    \"🔹 Código: \" + codigo + \"\\n\" +\n    \"🔹 Producto: \" + producto + \"\\n\" +\n    \"🔹 Categoría: \" + categoria + \"\\n\" +\n    \"🔹 Código fabricante: \" + (fabricante || \"No registrado\") + \"\\n\" +\n    \"🔹 Unidad: \" + (unidad || \"No registrada\") + \"\\n\" +\n    \"💰 Precio A CAF: \" + precio;\n\n  if (registros.length > 0) {\n    respuesta +=\n      \"\\n\\n📦 Existencias por bodega:\\n\" +\n      detalleBodegas +\n      \"\\n\\n📦 Existencia total: \" +\n      total.toLocaleString(\"en-US\", {\n        minimumFractionDigits: 0,\n        maximumFractionDigits: 2\n      }) +\n      \" unidades\";\n  } else {\n    respuesta +=\n      \"\\n\\n📦 Existencia: No se encontraron registros de existencia para este producto.\";\n  }\n\n  return respuesta;\n})()\n}}",
        "options": {}
      },
