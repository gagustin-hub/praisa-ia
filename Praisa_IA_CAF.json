      "name": "¿Cliente encontrado?"
    },
    {
      "parameters": {
        "message": "={{\n(() => {\n  const c = $json.cliente || {};\n\n  const limpio = (v) => (v ?? '').toString().trim();\n\n  const telefono = limpio(c.telefono);\n  const contacto = limpio(c.contacto);\n\n  const correo = [...new Set(\n    limpio(c.email)\n      .split(',')\n      .map(x => x.trim())\n      .filter(Boolean)\n  )].join(', ');\n\n  const faltantes = [];\n\n  if (!telefono) faltantes.push('Teléfono');\n  if (!contacto) faltantes.push('Contacto');\n  if (!correo) faltantes.push('Correo');\n\n  let respuesta =\n    \"Información consultada directamente en CAF Web:\\n\\n\" +\n    \"🔹 Cuenta: \" + limpio(c.cuenta) + \"\\n\" +\n    \"🔹 Cliente: \" + limpio(c.nombre_cliente) + \"\\n\" +\n    \"🔹 NIT: \" + limpio(c.nit) + \"\\n\" +\n    \"🔹 Dirección: \" + limpio(c.direccion) + \"\\n\" +\n    \"🔹 Ciudad: \" + limpio(c.ciudad) + \"\\n\" +\n    \"🔹 Teléfono: \" + (telefono || \"No registrado\") + \"\\n\" +\n    \"🔹 Contacto: \" + (contacto || \"No registrado\") + \"\\n\" +\n    \"🔹 Correo: \" + (correo || \"No registrado\");\n\n  if (faltantes.length > 0) {\n    respuesta +=\n      \"\\n\\n⚠️ Información pendiente de completar:\\n\" +\n      faltantes.map(campo => \"• \" + campo).join(\"\\n\");\n  } else {\n    respuesta +=\n      \"\\n\\n✅ El cliente tiene completos los datos principales de contacto en CAF Web.\";\n  }\n\n  return respuesta;\n})()\n}}",
        "options": {}
      },
