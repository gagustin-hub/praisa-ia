    },
    {
      "parameters": {
        "message": "={{\n(() => {\n  const registros = Array.isArray($json.v_existencia)\n    ? $json.v_existencia\n    : [];\n\n  if (registros.length === 0) {\n    return \"No encontré información de existencias para ese producto en CAF Web.\";\n  }\n\n  const limpio = (v) => (v ?? '').toString().trim();\n  const codigo = limpio(registros[0].codpro);\n\n  let total = 0;\n\n  const detalle = registros.map(r => {\n    const bodega = limpio(r.bodega);\n    const existencia = Number(r.existencia || 0);\n\n    total += existencia;\n\n    return \"🔹 Bodega \" + bodega + \": \" +\n      existencia.toLocaleString(\"en-US\", {\n        minimumFractionDigits: 0,\n        maximumFractionDigits: 2\n      }) +\n      \" unidades\";\n  }).join(\"\\n\");\n\n  return (\n    \"Existencias consultadas directamente en CAF Web:\\n\\n\" +\n    \"🔹 Código: \" + codigo + \"\\n\\n\" +\n    detalle +\n    \"\\n\\n📦 Existencia total: \" +\n    total.toLocaleString(\"en-US\", {\n      minimumFractionDigits: 0,\n      maximumFractionDigits: 2\n    }) +\n    \" unidades\"\n  );\n})()\n}}",
        "options": {}
      },
